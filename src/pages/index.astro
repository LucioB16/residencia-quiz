---
import fs from 'node:fs';
import path from 'node:path';
import questions from "../data/questions.json";
import "../styles/global.css";

const excludedContent = fs.readFileSync(path.join(process.cwd(), 'conversion-excluded-blocks.md'), 'utf-8');
const excludedCount = (excludedContent.match(/^### Pregunta \d+/gm) || []).length;

const totalQuestions = questions.length;
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const serializedQuestions = JSON.stringify(questions).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <style is:inline>
      .start-layout {
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-width: 800px;
        margin: 0 auto;
      }
      .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        border-radius: 16px;
        padding: 32px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .glass-panel:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.12);
      }
      .control-group {
        margin-bottom: 24px;
      }
      .control-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #333;
      }
      .mode-selector {
        display: flex;
        gap: 16px;
        margin-bottom: 16px;
      }
      .mode-card {
        flex: 1;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        background: #f8fafc;
      }
      .mode-card input {
        display: none;
      }
      .mode-card:has(input:checked) {
        border-color: #3b82f6;
        background: #eff6ff;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
      }
      .mode-card-title {
        font-weight: bold;
        font-size: 1.1rem;
        color: #1e293b;
        margin-bottom: 4px;
        display: block;
      }
      .mode-card-desc {
        font-size: 0.85rem;
        color: #64748b;
      }
      .source-dropdown {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        background-color: white;
        cursor: pointer;
        appearance: none;
        background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23475569%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
        background-repeat: no-repeat;
        background-position: right 16px top 50%;
        background-size: 12px auto;
        transition: border-color 0.2s;
      }
      .source-dropdown:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
      }
      .toggle-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
      }
      .toggle-switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 28px;
      }
      .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #cbd5e1;
        transition: .3s;
        border-radius: 28px;
      }
      .toggle-slider:before {
        position: absolute;
        content: "";
        height: 20px;
        width: 20px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
      }
      input:checked + .toggle-slider {
        background-color: #3b82f6;
      }
      input:checked + .toggle-slider:before {
        transform: translateX(22px);
      }
      .btn-start {
        width: 100%;
        padding: 16px;
        font-size: 1.1rem;
        font-weight: bold;
        border-radius: 12px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: none;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
      }
      .btn-start:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4);
      }
      .btn-start:active {
        transform: translateY(1px);
      }
      .hidden {
        display: none !important;
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Quiz estatico de preguntas Residencias Médicas Córdoba con ranking local en el navegador."
    />
    <link rel="icon" href={`${normalizedBase}favicon.svg`} />
    <title>Residencias Médicas Córdoba Quiz</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="topbar" aria-label="Encabezado">
        <a class="brand" href={normalizedBase} aria-label="Residencias Médicas Córdoba Quiz">
          <span class="brand-mark" aria-hidden="true">R</span>
          <span>
            <strong>Residencias Córdoba Quiz</strong>
            <small>{totalQuestions} preguntas</small>
          </span>
        </a>
      </header>

      <section class="quiz-surface" data-app data-excluded={excludedCount} aria-live="polite"></section>
    </main>

    <script id="questions-data" type="application/json" set:html={serializedQuestions}></script>
    <script>
      const questions = JSON.parse(document.getElementById("questions-data")?.textContent ?? "[]");
      const HISTORY_KEY = "residencia-quiz-history-v1";
      const app = document.querySelector("[data-app]");
      const excludedCount = app.dataset.excluded;
      
      const uniqueSources = [...new Set(questions.map(q => q.id.split('-')[0].trim()))].sort((a, b) => b.localeCompare(a));
      
      function getModeLabel(mode, randomize, source) {
        if (mode === "source") return `${source} ${randomize ? "(Mix)" : "(Ord)"}`;
        if (mode === "global") return `Global ${randomize ? "(Mix)" : "(Ord)"}`;
        if (mode === "random") return "orden aleatorio";
        return "orden original";
      }

      const state = {
        quizMode: "global",
        selectedSource: uniqueSources.length > 0 ? uniqueSources[0] : "",
        randomize: true,
        sequence: [],
        current: 0,
        correct: 0,
        incorrect: 0,
        startedAt: 0,
        finalDurationMs: 0,
        result: null,
        feedback: [],
        reportingError: false,
      };

      function escapeHtml(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function formatDuration(ms) {
        const totalSeconds = Math.max(0, Math.round(ms / 1000));
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}:${String(seconds).padStart(2, "0")}`;
      }

      function percentage(correct, total) {
        if (total === 0) return 0;
        return Math.round((correct / total) * 100);
      }

      function shuffle(items) {
        const copy = [...items];
        for (let index = copy.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(Math.random() * (index + 1));
          [copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]];
        }
        return copy;
      }

      function loadHistory() {
        try {
          const stored = localStorage.getItem(HISTORY_KEY);
          return stored ? JSON.parse(stored) : [];
        } catch {
          return [];
        }
      }

      function saveCompletedAttempt(record) {
        const history = loadHistory();
        history.push(record);
        localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-50)));
      }

      function rankedHistory() {
        return [...loadHistory()]
          .sort((left, right) => {
            if (right.percentage !== left.percentage) return right.percentage - left.percentage;
            if (left.durationMs !== right.durationMs) return left.durationMs - right.durationMs;
            return new Date(right.finishedAt).getTime() - new Date(left.finishedAt).getTime();
          })
          .slice(0, 8);
      }

      function renderHistory() {
        const history = rankedHistory();
        if (history.length === 0) {
          return `
            <section class="history-panel empty" aria-label="Ranking local">
              <h2>Ranking local</h2>
              <p>Sin intentos completos.</p>
            </section>
          `;
        }

        const rows = history.map((record, index) => {
          const date = new Intl.DateTimeFormat("es-AR", {
            dateStyle: "short",
            timeStyle: "short",
          }).format(new Date(record.finishedAt));

          return `
            <tr>
              <td>${index + 1}</td>
              <td>${escapeHtml(date)}</td>
              <td>${record.correct}</td>
              <td>${record.incorrect}</td>
              <td>${record.percentage}%</td>
              <td>${formatDuration(record.durationMs)}</td>
              <td>${escapeHtml(record.quizMode ? getModeLabel(record.quizMode, record.randomize, record.selectedSource) : getModeLabel(record.mode))}</td>
            </tr>
          `;
        }).join("");

        return `
          <section class="history-panel" aria-label="Ranking local">
            <h2>Ranking local</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Ok</th>
                    <th>Mal</th>
                    <th>%</th>
                    <th>Tiempo</th>
                    <th>Modo</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </section>
        `;
      }

      function bindStartEvents() {
        app.querySelectorAll("input[name='quizMode']").forEach((input) => {
          input.addEventListener("change", (e) => {
            state.quizMode = e.target.value;
            const sourceContainer = app.querySelector("#source-select-container");
            if (state.quizMode === "source") {
              sourceContainer.classList.remove("hidden");
            } else {
              sourceContainer.classList.add("hidden");
            }
          });
        });

        const sourceSelect = app.querySelector("#sourceSelect");
        if (sourceSelect) {
          sourceSelect.addEventListener("change", (e) => {
            state.selectedSource = e.target.value;
          });
        }

        const randomizeToggle = app.querySelector("#randomizeToggle");
        if (randomizeToggle) {
          randomizeToggle.addEventListener("change", (e) => {
            state.randomize = e.target.checked;
          });
        }

        app.querySelector("[data-action='start']").addEventListener("click", startQuiz);
      }

      function renderStart() {
        const sourcesOptions = uniqueSources.map(source => 
          `<option value="${source}" ${state.selectedSource === source ? "selected" : ""}>Examen ${source}</option>`
        ).join("");

        app.innerHTML = `
          <div class="start-layout">
            <section class="glass-panel">
              <p class="eyebrow" style="text-align: center; margin-bottom: 8px;">Banco Residencias Médicas Córdoba</p>
              <h1 style="text-align: center; margin-bottom: 24px; font-size: 2rem;">Cuestionario interactivo</h1>
              <div class="metric-strip" aria-label="Resumen" style="justify-content: center; margin-bottom: 32px;">
                <span><strong>${questions.length}</strong> preguntas</span>
                <a href="https://github.com/LucioB16/residencia-quiz/blob/main/conversion-excluded-blocks.md" target="_blank" rel="noopener noreferrer">
                  <strong>${excludedCount}</strong> excluidas
                </a>
              </div>

              <div class="control-group">
                <label>Modo de juego</label>
                <div class="mode-selector">
                  <label class="mode-card">
                    <input type="radio" name="quizMode" value="global" ${state.quizMode === "global" ? "checked" : ""}>
                    <span class="mode-card-title">Modo Global</span>
                    <span class="mode-card-desc">Todas las preguntas</span>
                  </label>
                  <label class="mode-card">
                    <input type="radio" name="quizMode" value="source" ${state.quizMode === "source" ? "checked" : ""}>
                    <span class="mode-card-title">Modo por Fuente</span>
                    <span class="mode-card-desc">Elegir un año/examen</span>
                  </label>
                </div>
              </div>

              <div class="control-group ${state.quizMode === "global" ? "hidden" : ""}" id="source-select-container">
                <label for="sourceSelect">Seleccionar Fuente</label>
                <select id="sourceSelect" class="source-dropdown">
                  ${sourcesOptions}
                </select>
              </div>

              <div class="control-group">
                <div class="toggle-container">
                  <div>
                    <strong>Mezclar el orden</strong>
                    <div style="font-size: 0.85rem; color: #64748b;">Aparición aleatoria de preguntas</div>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="randomizeToggle" ${state.randomize ? "checked" : ""}>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>

              <button class="btn-start" type="button" data-action="start">¡Comenzar Examen!</button>
            </section>

            ${renderHistory()}
          </div>
        `;
        bindStartEvents();
      }

      function startQuiz() {
        let filteredQuestions = questions;
        if (state.quizMode === "source") {
          filteredQuestions = questions.filter(q => q.id.startsWith(state.selectedSource));
        }
        state.sequence = state.randomize ? shuffle(filteredQuestions) : [...filteredQuestions].sort((a, b) => a.order - b.order);
        state.current = 0;
        state.correct = 0;
        state.incorrect = 0;
        state.startedAt = performance.now();
        state.finalDurationMs = 0;
        state.result = null;
        state.feedback = [];
        state.reportingError = false;
        renderQuestion();
      }

      function answer(optionId) {
        if (state.result) return;

        const question = state.sequence[state.current];
        const selected = question.options.find((option) => option.id === optionId);
        const correctOption = question.options.find((option) => option.isCorrect);

        if (selected?.isCorrect) {
          state.correct += 1;
          state.result = {
            kind: "correct",
            selectedId: optionId,
            correctId: correctOption.id,
          };
        } else {
          state.incorrect += 1;
          state.result = {
            kind: "incorrect",
            selectedId: optionId,
            correctId: correctOption.id,
          };
        }

        renderQuestion();
      }

      function skipQuestion() {
        if (state.result) return;

        const question = state.sequence[state.current];
        const correctOption = question.options.find((option) => option.isCorrect);
        state.incorrect += 1;
        state.result = {
          kind: "skipped",
          selectedId: null,
          correctId: correctOption.id,
        };
        renderQuestion();
      }

      function continueQuiz() {
        if (state.current + 1 >= state.sequence.length) {
          finishQuiz();
          return;
        }

        state.current += 1;
        state.result = null;
        state.reportingError = false;
        renderQuestion();
      }

      function finishQuiz() {
        state.finalDurationMs = performance.now() - state.startedAt;
        const finalPercentage = percentage(state.correct, state.sequence.length);
        saveCompletedAttempt({
          finishedAt: new Date().toISOString(),
          correct: state.correct,
          incorrect: state.incorrect,
          percentage: finalPercentage,
          durationMs: Math.round(state.finalDurationMs),
          quizMode: state.quizMode,
          selectedSource: state.selectedSource,
          randomize: state.randomize,
          mode: (state.quizMode === "global" && state.randomize) ? "random" : "original"
        });
        renderFinal();
      }

      function optionClass(option) {
        if (!state.result) return "option-button";
        if (option.isCorrect) return "option-button is-correct";
        if (state.result.selectedId === option.id) return "option-button is-wrong";
        return "option-button is-muted";
      }

      function renderResult(question) {
        if (!state.result) return "";

        const correctOption = question.options.find((option) => option.id === state.result.correctId);
        const resultTitle = {
          correct: "Correcta",
          incorrect: "Incorrecta",
          skipped: "Salteada",
        }[state.result.kind];

        return `
          <section class="result-panel ${state.result.kind}" aria-label="Resultado">
            <h2>${resultTitle}</h2>
            <p><strong>Opción correcta:</strong> ${correctOption.id}) ${escapeHtml(correctOption.text)}</p>
            <button class="primary-action compact" type="button" data-action="continue">Continuar</button>
          </section>
        `;
      }

      function bindQuestionEvents() {
        app.querySelectorAll("[data-option-id]").forEach((button) => {
          button.addEventListener("click", () => answer(button.dataset.optionId));
        });
        app.querySelector("[data-action='skip']")?.addEventListener("click", skipQuestion);
        app.querySelector("[data-action='continue']")?.addEventListener("click", continueQuiz);

        app.querySelector("[data-action='report-error']")?.addEventListener("click", () => {
          state.reportingError = true;
          renderQuestion();
        });

        app.querySelector("[data-action='cancel-feedback']")?.addEventListener("click", () => {
          state.reportingError = false;
          renderQuestion();
        });

        app.querySelector("[data-action='save-feedback']")?.addEventListener("click", () => {
          const text = app.querySelector("#feedback-input").value.trim();
          if (text) {
            state.feedback.push({
              questionId: state.sequence[state.current].id,
              text: text
            });
          }
          state.reportingError = false;
          renderQuestion();
        });
      }

      function renderFeedbackForm(question) {
        if (!state.result) return "";
        
        const existingFeedback = state.feedback.find(f => f.questionId === question.id);
        if (existingFeedback) {
          return `
            <div class="feedback-panel" style="margin-top: 18px; padding: 14px; border: 1px solid var(--green); border-radius: 8px; background: #eef8f1; color: var(--green);">
              <p style="margin: 0;">✓ Reporte guardado para esta pregunta. Se descargará al final.</p>
            </div>
          `;
        }

        if (state.reportingError) {
          return `
            <div class="feedback-panel" style="margin-top: 18px; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: #fff;">
              <label for="feedback-input" style="display:block; margin-bottom:8px; font-weight:bold;">¿Cuál considerás que es la opción correcta o qué error encontraste?</label>
              <textarea id="feedback-input" rows="3" style="width:100%; border-radius:4px; border:1px solid var(--line); padding:8px; margin-bottom:12px; font-family: inherit;"></textarea>
              <div style="display: flex; gap: 10px;">
                <button class="primary-action compact" type="button" data-action="save-feedback" style="margin-top:0;">Guardar reporte</button>
                <button class="secondary-action compact" type="button" data-action="cancel-feedback">Cancelar</button>
              </div>
            </div>
          `;
        }

        return `
          <div style="margin-top: 18px; text-align: right;">
            <button class="secondary-action compact" type="button" data-action="report-error" style="border-color: #ffd666; background: #fffbe6; color: #d48806;">⚠️ Reportar error</button>
          </div>
        `;
      }

      function renderQuestion() {
        const question = state.sequence[state.current];
        const currentNumber = state.current + 1;
        const total = state.sequence.length;
        const progress = Math.round((currentNumber / total) * 100);
        const options = question.options.map((option) => `
          <button
            class="${optionClass(option)}"
            type="button"
            data-option-id="${option.id}"
            ${state.result ? "disabled" : ""}
          >
            <span class="option-id">${option.id}</span>
            <span>${escapeHtml(option.text)}</span>
          </button>
        `).join("");

        app.innerHTML = `
          <article class="question-layout">
            <header class="question-meta">
              <div>
                <p class="eyebrow">Pregunta ${currentNumber} de ${total}</p>
                <h1>${escapeHtml(question.id)}</h1>
              </div>
              <div class="scoreboard" aria-label="Puntaje">
                <span><strong>${state.correct}</strong> correctas</span>
                <span><strong>${state.incorrect}</strong> incorrectas</span>
              </div>
            </header>

            <div class="progress-track" aria-hidden="true">
              <span style="width: ${progress}%"></span>
            </div>

            <section class="statement-panel">
              <p>${escapeHtml(question.statement)}</p>
            </section>

            <section class="options-grid" aria-label="Opciones">
              ${options}
            </section>

            <div class="quiz-actions">
              <span>Modo: ${escapeHtml(getModeLabel(state.quizMode, state.randomize, state.selectedSource))}</span>
              <button class="secondary-action" type="button" data-action="skip" ${state.result ? "disabled" : ""}>Saltear</button>
            </div>

            ${renderResult(question)}
            ${renderFeedbackForm(question)}
          </article>
        `;
        bindQuestionEvents();
      }

      function bindFinalEvents() {
        app.querySelector("[data-action='restart']").addEventListener("click", () => {
          state.result = null;
          renderStart();
        });
      }

      function downloadFeedback() {
        if (state.feedback.length === 0) return;
        
        const dataStr = JSON.stringify(state.feedback, null, 2);
        const blob = new Blob([dataStr], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        
        const modeIdentifier = state.quizMode === "global" ? "global" : state.selectedSource;
        
        const a = document.createElement('a');
        a.href = url;
        a.download = `feedback-residencias-${modeIdentifier}-${new Date().toISOString().slice(0,10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      function renderFinal() {
        const finalPercentage = percentage(state.correct, state.sequence.length);
        
        let feedbackMessage = "";
        if (state.feedback.length > 0) {
          feedbackMessage = `
            <div class="feedback-alert" style="margin-top: 18px; padding: 14px; background: #fffbe6; color: #d48806; border: 1px solid #ffe58f; border-radius: 8px;">
              <p style="margin: 0 0 8px;"><strong>¡Gracias por tu reporte!</strong></p>
              <p style="margin: 0;">Se descargó un archivo JSON con tus sugerencias. Por favor, envíalo a <a href="mailto:luciobotacin@gmail.com" style="color: #ad6800; text-decoration: underline; font-weight: bold;">luciobotacin@gmail.com</a> para procesarlo.</p>
            </div>
          `;
          setTimeout(downloadFeedback, 500);
        }

        app.innerHTML = `
          <div class="final-layout">
            <section class="final-panel">
              <p class="eyebrow">Resultado final</p>
              <h1>${finalPercentage}%</h1>
              <div class="final-stats">
                <span><strong>${state.correct}</strong> correctas</span>
                <span><strong>${state.incorrect}</strong> incorrectas</span>
                <span><strong>${formatDuration(state.finalDurationMs)}</strong> tiempo</span>
                <span><strong>${escapeHtml(getModeLabel(state.quizMode, state.randomize, state.selectedSource))}</strong> modo</span>
              </div>
              ${feedbackMessage}
              <div style="margin-top: 20px;">
                <button class="primary-action compact" type="button" data-action="restart">Reiniciar</button>
              </div>
            </section>
            ${renderHistory()}
          </div>
        `;
        bindFinalEvents();
      }

      renderStart();
    </script>
  </body>
</html>
